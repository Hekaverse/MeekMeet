# Meek Meet Web Environment Template
# Copy this file to .env.local and fill in your actual values.
# See GETTING_KEYS.md for instructions on obtaining each value.
# Never commit .env.local to version control.

# Supabase Configuration (new key system)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SECRET_KEY=<your-secret-key>

# Email
RESEND_API_KEY=<your-resend-api-key>

# Cron protection (generate a strong random string)
CRON_SECRET=<generate-a-secure-random-string>

# AI synthesis & question generation (Groq)
GROQ_API_KEY=<your-groq-api-key>

# Optional: geocoding circle locations (Google Cloud Console)
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Optional: daily news-driven questions (NewsAPI)
NEWS_API_KEY=<your-newsapi-key>
