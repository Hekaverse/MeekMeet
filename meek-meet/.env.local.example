# Supabase Configuration
# Get these from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Resend (email)
# Get this from your Resend dashboard > API Keys
RESEND_API_KEY=your-resend-api-key

# Cron secret for protecting the send-reminders API endpoint
# Generate a strong random string (e.g., openssl rand -base64 32)
CRON_SECRET=generate-a-strong-random-secret-here

# Optional: Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
